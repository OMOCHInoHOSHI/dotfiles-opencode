{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan", // 起動時のデフォルトをPlanモードに指定
  "model": "opencode-go/glm-5.3", // オーケストレーターのモデル
  // openrouterとgemini無効化中
  // "provider": {
  //   "openrouter": {
  //     "options": {
  //       "apiKey": "{env:OPENROUTER_API_KEY}",
  //       "baseURL": "https://openrouter.ai/api/v1"
  //     }
  //   },
  //   "google": {
  //     "options": {
  //       "apiKey": "{env:GEMINI_API_KEY}"
  //     }
  //   }
  // },

  // ロール別エージェント（モデル指定）
  "agent": {
    "plan": {
      "model": "opencode-go/glm-5.3",
      "variant": "high"
    },
    "build": {
      "model": "opencode-go/glm-5.3",
      "variant": "high"
    },
    "coder": {
      "description": "実装を担当するコーディング役。方針確定後の局所的な実装・テスト・ボイラープレートに使用。",
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.7-code"
    },
    "reviewer": {
      "description": "報告前のコードレビューを担当するレビュー役。",
      "mode": "subagent",
      "model": "opencode-go/qwen3.7-plus",
      "permission": {
        "edit": "deny"
      }
    },
    "researcher": {
      "description": "外部ライブラリ・API仕様・エラー原因などの調査を担当する調査役。",
      "mode": "subagent",
      "model": "opencode-go/glm-5.2",
      "variant": "max"
    }
  },
  // カスタム指示ファイル
  "instructions": [
    "./AGENT.md",
    "./instructions.md"
  ],
  // ツール実行の確認設定（デフォルトは allow、削除系のみ deny）
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "rmdir *": "deny"
    }
  }
}

